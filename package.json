{
  "name": "vue3-sdk-demo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "MitoJS Vue 3 交互式 SDK 演示",
  "repository": {
    "type": "git",
    "url": "https://github.com/mitojs/vue3-sdk-demo.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.22.2",
    "pnpm": ">=12.16.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 2033 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 2033 --strictPort",
    "test": "node tests/acceptance.mjs",
    "verify": "pnpm typecheck && pnpm build && pnpm test"
  },
  "dependencies": {
    "@mitojs/browser": "4.0.0-beta.1",
    "@mitojs/vue": "4.0.0-beta.1",
    "msw": "3.0.4",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vue-tsc": "3.3.14"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
